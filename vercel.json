{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/menu/:slug",
      "destination": "/api/seo-menu"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
